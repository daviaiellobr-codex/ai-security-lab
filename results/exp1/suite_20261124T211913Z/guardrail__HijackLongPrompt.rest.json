{
  "plugins": {
    "generators": {
      "rest": {
        "RestGenerator": {
          "uri": "http://127.0.0.1:8080/",
          "method": "post",
          "req_template_json_object": {
            "prompt": "$INPUT"
          },
          "response_json": true,
          "response_json_field": "response",
          "request_timeout": 400
        }
      }
    }
  }
}
